{
  "version": 2,
  "services": [
    {
      "name": "frontend",
      "src": "frontend"
    },
    {
      "name": "backend",
      "src": "backend"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/public/FinalFrontend/TK_Official/index.html",
      "dest": "frontend/$1"
    }
  ]
}