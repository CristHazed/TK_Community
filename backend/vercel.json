{
  "version": 2,
  "services": [
    {
      "name": "frontend",
      "src": "frontend"
    },
    {
      "name": "backend",
      "src": "backend"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}